# Salin menjadi .env (jangan di-commit). Hanya kunci publik (anon) yang boleh di aplikasi.
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon-key
# 1 jika proyek Supabase mendukung Image Transformation (paket Pro)
EXPO_PUBLIC_IMAGE_TRANSFORM=0
# 1 bila QRIS sudah terhubung ke penyedia sungguhan (server juga harus mengaktifkan setting qris_enabled)
EXPO_PUBLIC_QRIS_ENABLED=0
